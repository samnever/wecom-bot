# Codex 使用本机 `codex login` 保存的 ChatGPT 登录状态，无需 OpenAI API Key。
# 可选模型：gpt-6-astra、gpt-6-sol、gpt-6-luna、gpt-5.6-sol、gpt-5.6-terra、gpt-5.6-luna
# GPT-5.6 Luna + low 适合低延迟、高频聊天。
CODEX_MODEL=gpt-5.6-sol
# 可选推理强度：none、low、medium、high、xhigh、max
# 注意：gpt-6-astra 不支持 none。
CODEX_REASONING_EFFORT=medium
# 直接使用 HTTPS/SSE，跳过容易超时的 WebSocket 重连流程。
CODEX_HTTPS_ONLY=true
# GPT-5.6 Fast mode 可提升约 1.5 倍速度，但消耗约 2.5 倍 ChatGPT credits。
# 可选值：true、false
CODEX_FAST_MODE=false
# Codex 内部请求超时后，额外重试次数与重试间隔（毫秒）。
# 设为 1 表示最多执行 2 次完整请求，可延长网络不稳定时的总等待时间。
CODEX_MAX_RETRIES=1
CODEX_RETRY_DELAY_MS=2000
CODEX_WORKING_DIRECTORY=.codex-bot-runtime
CODEX_MAX_CONVERSATIONS=100

# 自动从指定所有者的聊天中学习 hwn 表达画像
HWN_LEARNING_ENABLED=false
# 先向机器人发送 /hwn whoami，再把返回值填在这里
HWN_OWNER_USER_ID=
HWN_OBSERVATION_BATCH_SIZE=50
HWN_MIN_CONFIDENCE=0.8
HWN_MAX_MESSAGE_CHARS=1000
# 默认值为当前 Windows 用户目录下的 .codex\skills\hwn，通常无需填写
# HWN_SKILL_DIRECTORY=C:\Users\你的用户名\.codex\skills\hwn
BOT_INSTRUCTIONS=你是企业微信中的内部 AI 助手。回答准确、简洁，并在不确定时明确说明。不要执行命令、修改文件或访问网络，只回答用户的问题。

# 企业微信智能机器人（API 模式 / 长连接）
WECOM_BOT_ID=replace_with_your_bot_id
WECOM_BOT_SECRET=replace_with_your_bot_secret

# 可选：私有化部署企业微信使用自己的 WebSocket 地址
# WECOM_WS_URL=wss://your-wecom-websocket-endpoint
