# Codex 使用本机 `codex login` 保存的 ChatGPT 登录状态，无需 OpenAI API Key。
# Luna + low 优先降低企业微信聊天延迟。
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=low
CODEX_WORKING_DIRECTORY=.codex-bot-runtime
CODEX_MAX_CONVERSATIONS=100
BOT_INSTRUCTIONS=你是企业微信中的内部 AI 助手。回答准确、简洁，并在不确定时明确说明。不要执行命令、修改文件或访问网络，只回答用户的问题。

# 企业微信智能机器人（API 模式 / 长连接）
WECOM_BOT_ID=replace_with_your_bot_id
WECOM_BOT_SECRET=replace_with_your_bot_secret

# 可选：私有化部署企业微信使用自己的 WebSocket 地址
# WECOM_WS_URL=wss://your-wecom-websocket-endpoint
